# Vektral-API — copy to .env (never commit secrets)

API_PORT=8788
LOG_LEVEL=INFO

# Firebase Admin (see ../FIREBASE.md)
# Project ID from the SA JSON (v1 GCS SA reused for Admin when Firebase is on same GCP project).
FIREBASE_PROJECT_ID=spatium-503617
# Mount path inside container / local path to SA JSON
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-sa.json
# false when secrets/firebase-sa.json exists; true only for SA-less local smoke
FIREBASE_STUB_MODE=false

# CORS — include lobby + VR Vite + Next
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Vektral-Web origin (VR SSO bridge redirects here → /auth/vr)
WEB_ORIGIN=http://127.0.0.1:3000

# VR lobby config
VEKTRAL_VR_WEB_ORIGIN=http://localhost:5173/
VEKTRAL_VR_AUTO_OPEN=true
# Comma-separated origins/paths; rejects open redirects
SSO_VR_CALLBACK_ALLOWLIST=http://localhost:5173/,http://127.0.0.1:5173/,http://localhost:5174/,http://127.0.0.1:5174/,http://localhost:3000/,http://127.0.0.1:3000/

# Vocal Bridge token mint (keys stay server-side)
VOCALBRIDGE_API_KEY=
VOCALBRIDGE_AGENT_ID=
VOCALBRIDGE_BASE_URL=https://vocalbridgeai.com
# Aliases also accepted: VOCAL_BRIDGE_*
VOICE_REQUIRE_AUTH=false
VOICE_UPSTREAM_TIMEOUT=30
VOICE_USER_AGENT=Vektral/1.0
VOICE_DEFAULT_PARTICIPANT=Vektral User

# API → Collab preview control (Wave 2/3)
PREVIEW_RUNNER_TOKEN=dev-preview-token
# Prefer PREVIEW_RUNNER_URL; COLLAB_INTERNAL_URL is an alias
PREVIEW_RUNNER_URL=http://collab:8790
COLLAB_INTERNAL_URL=http://collab:8790
PREVIEW_PUBLIC_BASE=http://127.0.0.1:8790/proxy

# Local smoke without Firebase SA (never in production)
ALLOW_DEV_BEARER=false
AUTH_DEV_BYPASS=false
VEKTRAL_USE_MEMORY_STORE=false

# Optional GH token when user has not completed /api/github/connect
GITHUB_TOKEN=

# Firecrawl + LLM (Mistral default, OpenRouter fallback — Wave 3 VR coding agent)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2
OPENROUTER_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Vektral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# GitHub OAuth (repo connect — Plan B)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
API_PUBLIC_URL=http://127.0.0.1:8788
TOKEN_ENCRYPTION_KEY=

# Linear OAuth (issue cards — same connect pattern as GitHub)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=
LINEAR_OAUTH_SCOPES=read,write,issues:create
